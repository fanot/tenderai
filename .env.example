# Провайдеры ИИ: local | openai | yandex | gigachat
EMBEDDINGS_PROVIDER=local
LLM_PROVIDER=local

# OpenAI (или любой OpenAI-совместимый API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Yandex Cloud (YandexGPT)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Сбер GigaChat
GIGACHAT_API_KEY=

# Прочее
DEFAULT_TOP_K=10
CORS_ORIGINS=*
